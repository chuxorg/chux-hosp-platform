# Mac localhost Auth0 test only; copy to ignored .env.local without overwriting it.
# See docs/AUTHENTICATION.md. No real credentials belong in this example.
# Existing Compose database defaults apply; preserve any local DB overrides.
APP_PORT=8000
AUTH_ENABLED=true
AUTH_ALLOW_INSECURE_HTTP=true
OIDC_ISSUER_URL=https://<auth0-domain>/
OIDC_CLIENT_ID=<client-id>
# Single quotes keep Compose from interpreting dollar signs in the local secret.
OIDC_CLIENT_SECRET='<fill-in-locally>'
OIDC_REDIRECT_URL=http://localhost:8000/auth/v1/callback
OIDC_LOGOUT_RETURN_URL=http://localhost:8000/
AUTH_SESSION_IDLE_TIMEOUT=8h
AUTH_SESSION_ABSOLUTE_LIFETIME=12h
